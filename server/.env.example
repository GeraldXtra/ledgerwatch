# LedgerWatch server environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every optional integration degrades gracefully when its vars are absent —
# the core app (auth, receivables, market watch, automation) always works.

# ----- Core -----
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/ledgerwatch   # or Atlas connection string
# The server REFUSES TO START if this is shorter than 32 characters or still
# reads like a placeholder. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string
# Leave BLANK rather than pasting a placeholder: a placeholder makes real
# requests that fail, blank falls back to the templates cleanly.
ANTHROPIC_API_KEY=
# Per call timeout. A draft that has not come back in this long is not coming
# back, and the template is right there. Bounds the reminder pass (LW-010).
ANTHROPIC_TIMEOUT_MS=30000

# ----- CoinGecko -----
# STRONGLY RECOMMENDED IN PRODUCTION, and not optional in the way the other
# integrations are. Live prices, coin LOGOS, the coin chart and coin search all
# read this one upstream, so an unauthenticated request that gets rate limited
# takes all four down together and the screen simply looks empty.
#
# Keyless works from a laptop and fails on a host: CoinGecko's free allowance is
# per IP and shared datacenter IPs (Render, Railway, Fly, Vercel, AWS) are
# usually already spent. A free demo key from coingecko.com/en/api fixes it.
#
# Leave COINGECKO_PLAN unset (or "demo") for a demo key. Set it to "pro" only
# with a Pro key: that switches the host to pro-api.coingecko.com and the header
# to x-cg-pro-api-key. Mixing a key with the wrong plan is a 401.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# ----- Sign in with Google (optional) -----
# A redirect flow, not a button widget, so no Google script ever runs in the
# page that decrypts wallet keys. Absent, the button on the sign in page says
# it is not switched on and everything else works.
#
# Create an OAuth client of type "Web application" at
# console.cloud.google.com/apis/credentials and add this EXACT redirect URI:
#   <SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public base URL of THIS API, no trailing slash. Google sends the browser
# back here, so it must be the address Google can reach, not localhost in
# production. Also used for nothing else.
SERVER_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173                  # CORS; comma-separate multiple origins
NODE_ENV=development
AUTOMATION_INTERVAL_MS=15000                      # pass interval (ms). 15s for a live demo: a payment surfaces in ~40s.
                                                  # Detection AND confirmation each need a pass, so latency is ~2x this.
                                                  # Raise to 300000 in production - the same loop drives reminders and
                                                  # price polling, so a short interval costs more CoinGecko/RPC calls.

# ----- Messaging (Phase 5) — WhatsApp via Twilio. Absent => manual wa.me link only. -----
TWILIO_ACCOUNT_SID=                               # from console.twilio.com
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886        # Twilio sandbox sender (or your approved number)

# ----- Messaging (Phase 5) — Email via SMTP. Absent => email sends are skipped. -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=                                         # Gmail: use a 16-char App Password, NOT your login password
MAIL_FROM=LedgerWatch <you@gmail.com>

# ----- Push notifications — Web Push / VAPID. -----
# Absent => push is disabled and the app falls back silently to in-app toasts.
# Generate the pair once with:   npx web-push generate-vapid-keys
# The public key is served to the browser; the private key must stay server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com               # contact address required by the Web Push spec

# ----- Wallet and chains -----
ALCHEMY_API_KEY=                                   # optional; blank => public RPC endpoints only
# Mainnet. `true` exposes the seven real money chains in the wallet, the network
# switcher and the payment address issuer. The registry's mainnet entries were
# verified against the live chains on 2026-08-29 (npm run verify:chains:mainnet),
# so the addresses and endpoints are real rather than recalled.
#
# THIS TEMPLATE STAYS false ON PURPOSE. A fresh clone should not begin able to
# move somebody's money, and the difference between the two settings is not a
# feature flag, it is the difference between a mistake costing nothing and a
# mistake being irreversible. Set it to true deliberately, in your own .env,
# once you have read docs/SECURITY.md section 5.
ENABLE_MAINNET=false

# ----- Crypto payment addresses for invoices -----
# Invoice addresses are derived on the branch m/44'/60'/0'/2/<index>. BIP-44 uses
# change-level 0 for receive and 1 for change, so level 2 is a branch no standard
# wallet touches — receivables addresses can never collide with the user's own.
#
# Stablecoins per chain are configured in src/config/chains.js and were verified
# against the live contracts. Mainnets carry USDC and, where verified, USDT. The
# testnets carry Circle's official testnet USDC only (there is no official testnet
# USDT), so on a testnet the reminder tells payers "send USDC only":
#   Sepolia          0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
#   Base Sepolia     0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Arbitrum Sepolia 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
#   Optimism Sepolia 0x5fd84259d66Cd46123540766Be93DFE6D43130D7
#   Polygon Amoy     0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# Confirmation depth before a payment is trusted enough to settle an invoice.
# Defaults: 12 on Ethereum Sepolia (L1 reorgs run a few blocks deep), 5 on L2s.
CONFIRMATIONS_11155111=12
CONFIRMATIONS_84532=5
CONFIRMATIONS_421614=5
CONFIRMATIONS_11155420=5
CONFIRMATIONS_80002=5

# After expiry an address stops active watching, but late funds must never be lost
# silently — it stays under a low-frequency grace watch for this many days.
PAYMENT_GRACE_DAYS=30

# How often each expired address is re-checked during that grace window. The grace
# pass costs one balanceOf call per address and only scans logs when the balance
# shows money it cannot account for, so this can be generous. Late payments are
# rare and never urgent; checking every minute for 30 days would be pure waste.
PAYMENT_GRACE_SCAN_MINUTES=60

# Each generation permanently burns a derivation index, so cap the rate per user.
MAX_PAYMENT_ADDRESSES_PER_HOUR=20

# NGN per USD, used only if CoinGecko is unreachable when snapshotting the rate.
# The live rate is preferred and its age is always shown in the UI.
NGN_PER_USD_FALLBACK=1600

# Settlement tolerance: a payer within this fraction of the asked amount has paid in
# full. Absorbs rounding and any fee dust taken in transit. 0.005 = 0.5%.
USDC_SETTLEMENT_TOLERANCE=0.005

# The tolerance above is a PERCENTAGE, and a percentage of a nine figure naira
# invoice is not rounding dust. Both caps below bound it in absolute terms, which
# is what stops a large invoice being marked paid in full while a real amount is
# still owed. Raise them only if a payment rail genuinely deducts more, and write
# down which one and why.
#   SETTLEMENT_MAX_DUST_NGN  the most naira a debt may be short and still close
#   USDC_MAX_SHORTFALL       the most token units a crypto payment may be short
SETTLEMENT_MAX_DUST_NGN=100
USDC_MAX_SHORTFALL=0.05

# Block range per eth_getLogs call. OPTIONAL, AND ONLY A CAP.
#
# Each chain in src/config/chains.js carries a MEASURED `logSpan`: the widest
# range its slowest endpoint served within the timeout (npm run verify:chains).
# That measured value is what the watcher and the wallet scan use. Setting either
# variable here can only NARROW it, for an operator nursing a misbehaving node;
# it can never widen it, because a range past what a node serves fails silently:
# this file once shipped 4000 against a node that capped at 2000, every log
# query was rejected, the watcher returned null quietly, and lastScannedBlock
# stayed at 0 forever while the scan looked perfectly healthy.
#PAYMENT_WATCH_BLOCK_SPAN=1500
#WALLET_HISTORY_BLOCK_SPAN=1500

# The wallet's inbound scan: how many windows a FIRST look reaches back from the
# chain head, and how many a later load may read while catching up a gap. The
# cursor only ever advances over blocks that were actually read, so a gap longer
# than one load's worth is finished on the next.
WALLET_HISTORY_WINDOWS=4
WALLET_HISTORY_RESUME_WINDOWS=8

# Per-endpoint timeout for any server-to-chain JSON-RPC call, in milliseconds.
# Applies to each endpoint in a chain's list separately, so a chain with three
# endpoints can take up to 3x this in the worst case. There was no timeout at all
# before, which meant a hung upstream held the request open until the browser gave
# up — and the balance screen fans out several calls at once.
RPC_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# WHATSAPP DELIVERY
#
#   link   (default) Free. Costs nothing and needs no account anywhere. The app
#          prepares the message and gives you a one tap wa.me link to send it
#          from your own WhatsApp. Cannot send unattended.
#
#   cloud  WhatsApp Cloud API, direct from Meta with no reseller in between.
#          Meta's free tier covers a small business and there is no per message
#          platform fee. This is the only option that sends while nobody is
#          watching. Business initiated reminders outside a 24 hour window need
#          an approved message template.
#
#   twilio Kept so an existing setup keeps working. Bills on top of Meta's own
#          fee and its sandbox needs every recipient to text a join code first,
#          which no debtor will do. Not recommended.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=link

# Only for WHATSAPP_PROVIDER=cloud. From Meta Business > WhatsApp > API setup.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_VERSION=v21.0

# ---------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE  the human check on sign in and sign up
#
# Free, unlimited, and no personal data leaves the browser. Create a widget at
# https://dash.cloudflare.com  >  Turnstile  >  Add widget.
#   Widget mode: MANAGED   (this is the one that shows the tick box a person
#                           clicks. Non interactive and Invisible modes give no
#                           box to click.)
#   Hostnames:   useledgerwatch.co  and  localhost
#
# Cloudflare gives you TWO keys. The Site Key is public and belongs to the
# client; the Secret Key is private and must only ever live here on the server.
# Leave the secret unset and the check is skipped, so local work is never
# blocked by it.
#
# Cloudflare's always passes test secret, useful while wiring things up:
#   1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
# This is the documented always-passes TEST secret. The boot log says "TEST
# MODE" while it is in use; replace it with your widget's real secret in
# production. Never commit that one anywhere.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
