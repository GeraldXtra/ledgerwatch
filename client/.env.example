VITE_API_URL=http://localhost:8000

# Cloudflare Turnstile SITE key (the public half). Pairs with
# TURNSTILE_SECRET_KEY on the server. Safe to expose: it is visible in the page
# source by design. Vite inlines this at BUILD time, so it must be set in the
# Vercel build environment, not only in a local file.
# This carried what looks like a real production site key, sitting directly under
# the line naming Cloudflare's test key as the value to use. Site keys are public
# so nothing leaked, but a site key is bound to specific DOMAINS: anyone copying
# this file for their own deployment inherited a key that does not match theirs,
# so the human check failed on every sign in attempt while the file itself named
# the value that would have worked. That is the same shape as LW-070 on the
# server side. The always-passes TEST key is the correct default for an example,
# and a real key belongs in the Vercel build environment and nowhere else.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# How long a signed swap stays valid, in seconds. Default 1200 (twenty minutes).
#
# The deadline is encoded INTO the transaction, through SwapRouter02's
# `multicall(deadline, [...])`, so a swap that is not mined in time is rejected
# by the router rather than sitting in the mempool waiting to execute at a price
# nobody agreed to. Lower is safer and more likely to fail on a congested chain;
# higher is the reverse.
#
# Optional, and inlined at BUILD time like the two above. Absent, it is 1200 —
# which is the right default, and is documented here only because a value that
# silently defaults is a value nobody knows exists.
VITE_SWAP_DEADLINE_SECONDS=1200
